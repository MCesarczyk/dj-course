          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "editorMode": "code",
          "expr": "topk(10, histogram_quantile(0.95, sum(rate(http_server_duration_milliseconds_bucket{exported_job=\"products-api\",http_route=~\"$route\",http_method=~\"$method\"}[$__range])) by (le, http_route, http_method)) >= 0)",
